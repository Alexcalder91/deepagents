// Prisma schema for DeepAgents webapp
// Database: singularity-db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Chat model - represents a conversation
model Chat {
  id        String    @id @default(cuid())
  title     String    @default("New Chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@map("chats")
}

// Message model - represents individual messages in a chat
model Message {
  id        String   @id @default(cuid())
  role      String   // "user" or "assistant"
  content   String   @db.Text
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Tool steps stored as JSON
  toolSteps Json?

  // Canvas data stored as JSON
  canvas    Json?

  @@index([chatId])
  @@map("messages")
}

// Memory model - represents memory files
model Memory {
  id        String   @id @default(cuid())
  name      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("memories")
}

// PromptConfig model - represents system prompt configuration
model PromptConfig {
  id              String   @id @default(cuid())
  systemPrompt    String   @db.Text
  customInstructs String   @db.Text @default("")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("prompt_configs")
}

// ============================================
// Agent Builder Models
// ============================================

// Agent - the main entity for configured agents
model Agent {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  instructions String   @db.Text @default("")
  model        String   @default("claude-sonnet-4-5-20250929")
  isActive     Boolean  @default(true)
  canvasState  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tools     AgentTool[]
  subagents AgentSubagent[]
  skills    AgentSkill[]
  triggers  AgentTrigger[]
  testChats AgentTestChat[]

  @@map("agents")
}

// AgentTool - tool configuration for an agent
model AgentTool {
  id                String   @id @default(cuid())
  agentId           String
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  toolType          String
  toolName          String
  toolConfig        Json?
  requiresReview    Boolean  @default(false)
  reviewDestination String?
  reviewConfig      Json?
  positionX         Float    @default(0)
  positionY         Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([agentId])
  @@map("agent_tools")
}

// AgentSubagent - subagent configuration
model AgentSubagent {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name         String
  description  String   @db.Text
  systemPrompt String   @db.Text
  model        String?
  toolIds      String[]
  positionX    Float    @default(0)
  positionY    Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agentId])
  @@map("agent_subagents")
}

// AgentSkill - skill configuration
model AgentSkill {
  id               String   @id @default(cuid())
  agentId          String
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillPath        String
  skillName        String
  skillDescription String?  @db.Text
  positionX        Float    @default(0)
  positionY        Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agentId])
  @@map("agent_skills")
}

// AgentTrigger - trigger configuration
model AgentTrigger {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  triggerType String
  name        String
  description String?
  config      Json
  isEnabled   Boolean  @default(true)
  positionX   Float    @default(0)
  positionY   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentId])
  @@map("agent_triggers")
}

// AgentTestChat - test chat sessions
model AgentTestChat {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title     String   @default("Test Session")
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@map("agent_test_chats")
}

// ToolApproval - pending tool approval requests
model ToolApproval {
  id             String    @id @default(cuid())
  executionId    String
  toolName       String
  toolInput      Json
  status         String
  modifiedInput  Json?
  notifiedVia    String?
  notificationId String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?

  @@index([executionId])
  @@index([status])
  @@map("tool_approvals")
}
